# ==============================================================================
# MindStrip Environment Variables Template
# Meta Global AI Developer Hackathon
# ==============================================================================
# Copy this file to .env.local and fill in your API keys.
# .env.local is strictly gitignored to comply with the Zero-Secret Policy.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Meta Model API (Official Hackathon Endpoint)
# ------------------------------------------------------------------------------
# Get your key from the Meta Model API dashboard / Meta Hackathon portal.
# Models: llama-3.3-70b-instruct, muse-image, muse-spark-1.3
META_MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1

# ------------------------------------------------------------------------------
# 2. Meta Hackathon Partner APIs (Alternative Providers)
# ------------------------------------------------------------------------------
# Fireworks AI (Meta Llama 3.3 + Flux Schnell image generation)
# https://fireworks.ai/
FIREWORKS_API_KEY=

# Groq (Sub-second ultra-fast Meta Llama 3.3 inference)
# https://groq.com/
GROQ_API_KEY=

# Baseten (High-throughput Meta Llama 3.3 serving)
# https://baseten.co/
BASETEN_API_KEY=
BASETEN_BASE_URL=https://bridge.baseten.co/v1

# ------------------------------------------------------------------------------
# 3. Database (Optional Cloud Persistence)
# ------------------------------------------------------------------------------
# Free MongoDB Atlas M0 Cluster (512MB free forever, no credit card required)
# https://www.mongodb.com/cloud/atlas/register
# Connection string format:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/mindstrip?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 4. Permanent CDN Image Storage (Vercel Blob)
# ------------------------------------------------------------------------------
# 1-Click setup on Vercel Dashboard -> Project -> Storage -> Create Database -> Blob.
# Automatically injected into your production environment by Vercel.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
